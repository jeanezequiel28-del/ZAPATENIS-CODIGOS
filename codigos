/*
 * ZAPATENIS - JavaScript principal
 * Un solo archivo coordina la tienda, el área administrativa y las facturas.
 * No se guardan ni se envían números completos de tarjeta ni CVV.
 */
(function () {
  'use strict';

  const $ = (selector, root = document) => root.querySelector(selector);
  const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];
  const API = async (url, options = {}) => {
    const config = {
      method: options.method || 'GET',
      credentials: 'same-origin',
      headers: { ...(options.body ? { 'Content-Type': 'application/json' } : {}) },
      ...(options.body ? { body: options.body } : {})
    };
    const response = await fetch(url, config);
    const result = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(result.error || 'No se pudo completar la operación.');
    return result;
  };
  const escapeHTML = value => String(value ?? '').replace(/[&<>"']/g, char => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  })[char]);
  const money = value => new Intl.NumberFormat('es-DO', {
    style: 'currency', currency: 'DOP', minimumFractionDigits: 2
  }).format(Number(value) || 0);
  const dateText = value => {
    if (!value) return '—';
    const d = new Date(`${String(value).slice(0,10)}T12:00:00`);
    return Number.isNaN(d.getTime()) ? String(value) : new Intl.DateTimeFormat('es-DO', {
      day:'2-digit', month:'2-digit', year:'numeric'
    }).format(d);
  };
  const today = () => {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
  };
  const setMessage = (element, message, type = 'error') => {
    if (!element) return;
    element.textContent = message;
    element.className = `message-box ${type}`;
    element.hidden = false;
  };
  const clearMessage = element => { if (element) { element.hidden = true; element.textContent = ''; } };
  const readSession = async () => {
    try { return (await API('/api/me')).user || null; }
    catch { return null; }
  };
  const getCart = () => {
    try {
      const parsed = JSON.parse(localStorage.getItem('zapatenis-cart') || '[]');
      return Array.isArray(parsed) ? parsed.filter(x => Number(x.id) > 0 && Number(x.quantity) > 0) : [];
    } catch { return []; }
  };
  const saveCart = items => {
    localStorage.setItem('zapatenis-cart', JSON.stringify(items));
    updateCartCount();
  };
  const updateCartCount = () => {
    const count = getCart().reduce((sum, item) => sum + Number(item.quantity), 0);
    $$('[data-cart-count]').forEach(node => node.textContent = count);
  };
  const imageMarkup = product => {
    const src = String(product.image_url || '').trim();
    if (!src) return '<div class="product-placeholder" aria-label="Imagen pendiente">👟</div>';
    return `<img src="${escapeHTML(src)}" alt="${escapeHTML(product.name)}" loading="lazy" onerror="this.parentElement.innerHTML='<div class=&quot;product-placeholder&quot;>👟</div>'">`;
  };
  const productCard = product => `
    <article class="product-card">
      <a href="#producto/${Number(product.id)}" data-open-product="${Number(product.id)}">
        <div class="product-visual">${imageMarkup(product)}</div>
        <div class="product-info">
          <span class="product-brand">${escapeHTML(product.brand)} · ${escapeHTML(product.category)}</span>
          <h3 class="product-name">${escapeHTML(product.name)}</h3>
          <p class="product-meta">${escapeHTML(product.audience)} · Talla ${escapeHTML(product.size || '—')}</p>
          <div class="product-price">${money(product.sale_price)}</div>
        </div>
      </a>
      <div class="product-actions">
        <button class="button button-outline" data-open-product="${Number(product.id)}">DETALLES</button>
        <button class="button button-dark" data-add-cart="${Number(product.id)}" ${Number(product.stock) < 1 ? 'disabled' : ''}>${Number(product.stock) < 1 ? 'AGOTADO' : 'AGREGAR'}</button>
      </div>
    </article>`;

  /* ========================= TIENDA ========================= */
  async function startStore() {
    const user = await readSession();
    window.ZAPATENIS_USER = user;
    updateStoreHeader(user);
    updateCartCount();
    bindStoreCommon(user);
    await loadFeatured();
    bindAuthForms();
    bindCartAndCheckout(user);
    bindStoreRouting(user);
    const initial = location.hash || '#home';
    await routeStore(initial, user);
  }

  function updateStoreHeader(user) {
    $$('[data-guest-only]').forEach(el => el.hidden = Boolean(user));
    $$('[data-client-only]').forEach(el => el.hidden = !user || user.role !== 'cliente');
    $$('[data-user-name]').forEach(el => {
      el.hidden = !user;
      el.textContent = user ? user.name : '';
    });
    $$('[data-open-admin]').forEach(el => el.hidden = !user || user.role !== 'admin');
    $$('[data-logout]').forEach(el => el.hidden = !user);
    $$('[data-year]').forEach(el => el.textContent = new Date().getFullYear());
  }

  function bindStoreCommon(user) {
    document.addEventListener('click', async event => {
      const logout = event.target.closest('[data-logout]');
      if (logout) {
        try { await API('/api/logout', { method:'POST' }); localStorage.removeItem('zapatenis-cart'); location.href = 'index.html'; }
        catch (err) { alert(err.message); }
        return;
      }
      const admin = event.target.closest('[data-open-admin]');
      if (admin) { location.href = 'admin.html'; return; }
      const route = event.target.closest('[data-route]');
      if (route) {
        event.preventDefault();
        location.hash = route.dataset.route;
        return;
      }
      const audience = event.target.closest('[data-audience]');
      if (audience) {
        const value = audience.dataset.audience;
        location.hash = `shop?audience=${encodeURIComponent(value)}`;
        return;
      }
      const category = event.target.closest('[data-category]');
      if (category) {
        const value = category.dataset.category;
        location.hash = `shop?category=${encodeURIComponent(value)}`;
        return;
      }
      const openProduct = event.target.closest('[data-open-product]');
      if (openProduct) {
        event.preventDefault();
        location.hash = `producto/${Number(openProduct.dataset.openProduct)}`;
        return;
      }
      const add = event.target.closest('[data-add-cart]');
      if (add) {
        event.preventDefault();
        try { await addToCart(Number(add.dataset.addCart), user); alert('Producto agregado a tu bolsa.'); }
        catch (err) { alert(err.message); }
      }
    });
  }

  async function addToCart(productId, user) {
    if (!user) {
      location.hash = 'login';
      throw new Error('Inicia sesión o crea una cuenta de cliente para agregar productos.');
    }
    if (user.role !== 'cliente') throw new Error('La cuenta de administrador gestiona el inventario desde Administración.');
    const product = await API(`/api/products/${productId}`);
    if (product.stock < 1) throw new Error('Este producto está agotado.');
    const cart = getCart();
    const existing = cart.find(item => Number(item.id) === productId);
    if (existing) {
      if (existing.quantity + 1 > product.stock) throw new Error(`Solo quedan ${product.stock} unidades disponibles.`);
      existing.quantity += 1;
    } else cart.push({ id:productId, quantity:1 });
    saveCart(cart);
  }

  async function loadFeatured() {
    const target = $('#featured-products');
    if (!target) return;
    try {
      const products = await API('/api/products');
      target.innerHTML = products.slice(0,8).map(productCard).join('') || '<p class="empty-state">Todavía no hay productos disponibles.</p>';
    } catch (err) { target.innerHTML = `<p class="empty-state">${escapeHTML(err.message)}</p>`; }
  }

  function bindStoreRouting(user) {
    window.addEventListener('hashchange', () => routeStore(location.hash, user));
  }

  async function routeStore(hash, user) {
    const sections = $$('[data-view-section]');
    let view = 'home';
    const productMatch = hash.match(/^#producto\/(\d+)/);
    let query = '';
    if (productMatch) view = 'product';
    else {
      const cleaned = hash.replace(/^#/, '');
      const [name, queryString] = cleaned.split('?');
      view = ['home','shop','product','cart','checkout','login','register','invoices'].includes(name) ? name : 'home';
      query = queryString || '';
    }
    sections.forEach(section => section.hidden = section.dataset.viewSection !== view);
    window.scrollTo({ top:0, behavior:'instant' });

    if (view === 'shop') await loadCatalog(query);
    if (view === 'product' && productMatch) await loadProduct(Number(productMatch[1]));
    if (view === 'cart') await renderCart(user);
    if (view === 'checkout') await prepareCheckout(user);
    if (view === 'invoices') await loadCustomerInvoices(user);
  }

  async function loadCatalog(queryString = '') {
    const container = $('#catalog-products');
    if (!container) return;
    container.innerHTML = '<p class="empty-state">Cargando catálogo…</p>';
    try {
      const params = new URLSearchParams(queryString);
      const filters = {
        audience: params.get('audience') || 'todos',
        category: params.get('category') || 'todos'
      };
      const products = await API('/api/products');
      window._catalogProducts = products;
      const brandSelect = $('#filter-brand');
      const sizeSelect = $('#filter-size');
      const fill = (select, values, label) => {
        const old = select.value;
        select.innerHTML = `<option value="todos">${label}</option>`;
        [...new Set(values.filter(Boolean))].sort((a,b)=>String(a).localeCompare(String(b),'es')).forEach(value => {
          const opt = document.createElement('option'); opt.value=value; opt.textContent=value; select.appendChild(opt);
        });
        if ([...select.options].some(o=>o.value===old)) select.value=old;
      };
      fill(brandSelect, products.map(p=>p.brand), 'Todas las marcas');
      fill(sizeSelect, products.map(p=>p.size), 'Todas las tallas');
      $$('input[name="filter-audience"]').forEach(el=>el.checked=el.value===filters.audience);
      $$('input[name="filter-category"]').forEach(el=>el.checked=el.value===filters.category);
      if (!$$('input[name="filter-audience"]').some(el=>el.checked)) $('input[name="filter-audience"][value="todos"]').checked=true;
      if (!$$('input[name="filter-category"]').some(el=>el.checked)) $('input[name="filter-category"][value="todos"]').checked=true;
      $('#search-form').onsubmit = e => { e.preventDefault(); renderCatalog(); };
      $('#search-products').oninput = renderCatalog;
      $('#filter-brand').onchange = renderCatalog;
      $('#filter-size').onchange = renderCatalog;
      $('#sort-products').onchange = renderCatalog;
      $$('input[name="filter-audience"],input[name="filter-category"]').forEach(el=>el.onchange=renderCatalog);
      $('#clear-filters').onclick = () => {
        $('#search-products').value=''; $('#filter-brand').value='todos'; $('#filter-size').value='todos'; $('#sort-products').value='recent';
        $('input[name="filter-audience"][value="todos"]').checked=true;
        $('input[name="filter-category"][value="todos"]').checked=true;
        renderCatalog();
      };
      renderCatalog();
    } catch(err) { container.innerHTML=`<p class="empty-state">${escapeHTML(err.message)}</p>`; }
  }

  function renderCatalog() {
    const all = window._catalogProducts || [];
    const search = ($('#search-products')?.value || '').trim().toLowerCase();
    const audience = $('input[name="filter-audience"]:checked')?.value || 'todos';
    const category = $('input[name="filter-category"]:checked')?.value || 'todos';
    const brand = $('#filter-brand')?.value || 'todos';
    const size = $('#filter-size')?.value || 'todos';
    const sort = $('#sort-products')?.value || 'recent';
    let list = all.filter(p => {
      const content = [p.name,p.brand,p.description,p.size,p.color].join(' ').toLowerCase();
      return (!search || content.includes(search)) && (audience==='todos'||p.audience===audience) && (category==='todos'||p.category===category) && (brand==='todos'||p.brand===brand) && (size==='todos'||String(p.size)===String(size));
    });
    if (sort==='name') list.sort((a,b)=>a.name.localeCompare(b.name,'es'));
    if (sort==='low') list.sort((a,b)=>a.sale_price-b.sale_price);
    if (sort==='high') list.sort((a,b)=>b.sale_price-a.sale_price);
    $('#catalog-count').textContent = `${list.length} producto(s)`;
    $('#catalog-products').innerHTML = list.map(productCard).join('') || '<p class="empty-state">No hay productos que coincidan con esos filtros.</p>';
  }

  async function loadProduct(id) {
    const root = $('#product-detail');
    if (!root) return;
    root.innerHTML = '<p class="empty-state">Cargando producto…</p>';
    try {
      const p = await API(`/api/products/${id}`);
      root.innerHTML = `
        <div class="product-detail-layout">
          <div class="product-detail-photo">${p.image_url ? `<img src="${escapeHTML(p.image_url)}" alt="${escapeHTML(p.name)}" onerror="this.outerHTML='<div class=&quot;product-placeholder&quot;>👟</div>'">` : '<div class="product-placeholder">👟</div>'}</div>
          <div class="product-detail-info">
            <span class="eyebrow">${escapeHTML(p.brand)} · ${escapeHTML(p.category)}</span>
            <h1>${escapeHTML(p.name)}</h1>
            <div class="detail-price">${money(p.sale_price)}</div>
            <p class="detail-description">${escapeHTML(p.description || 'Producto disponible en ZAPATENIS.')}</p>
            <div class="detail-meta-grid"><div><span>Público</span><strong>${escapeHTML(p.audience)}</strong></div><div><span>Categoría</span><strong>${escapeHTML(p.category)}</strong></div><div><span>Talla</span><strong>${escapeHTML(p.size || '—')}</strong></div><div><span>Color</span><strong>${escapeHTML(p.color || '—')}</strong></div></div>
            <p class="detail-stock">${p.stock>0 ? `Disponibles: ${p.stock}` : 'Agotado'}</p>
            <button class="button button-dark" id="detail-add" ${p.stock<1?'disabled':''}>AGREGAR A LA BOLSA</button>
          </div>
        </div>`;
      $('#detail-add').onclick = async () => {
        try { await addToCart(p.id,window.ZAPATENIS_USER); alert('Producto agregado.'); }
        catch(err) { alert(err.message); }
      };
      const related = (await API('/api/products')).filter(x=>x.id!==p.id && x.category===p.category).slice(0,4);
      $('#related-products').innerHTML = related.map(productCard).join('');
    } catch(err) { root.innerHTML=`<p class="message-box error">${escapeHTML(err.message)}</p>`; }
  }

  async function renderCart(user) {
    const root = $('#cart-items');
    const cart = getCart();
    if (!user || user.role!=='cliente') {
      root.innerHTML = '<div class="empty-state"><h3>Inicia sesión como cliente para comprar.</h3><button class="button button-dark" data-route="login">INICIAR SESIÓN</button></div>';
      $('#go-checkout').disabled=true; updateCartTotals(0); return;
    }
    if (!cart.length) {
      root.innerHTML = '<div class="empty-state"><h3>Tu bolsa está vacía.</h3><p>Explora los tenis disponibles y agrega tus favoritos.</p><button class="button button-dark" data-route="shop">IR A LA TIENDA</button></div>';
      $('#go-checkout').disabled=true; updateCartTotals(0); return;
    }
    try {
      const products = await API('/api/products');
      let subtotal=0;
      const valid=[];
      root.innerHTML = cart.map(item => {
        const p = products.find(product=>product.id===Number(item.id));
        if (!p || p.stock<1) return '';
        const quantity = Math.min(Number(item.quantity),Number(p.stock));
        valid.push({id:p.id,quantity});
        subtotal += Number(p.sale_price)*quantity;
        return `<article class="cart-item"><div class="cart-item-image">${p.image_url?`<img src="${escapeHTML(p.image_url)}" alt="${escapeHTML(p.name)}" onerror="this.replaceWith(document.createTextNode('👟'))">`:'<span>👟</span>'}</div><div><h3>${escapeHTML(p.name)}</h3><p>${escapeHTML(p.brand)} · Talla ${escapeHTML(p.size||'—')}</p><p>${money(p.sale_price)} por unidad</p><div class="quantity-control"><button data-cart-minus="${p.id}" aria-label="Disminuir">−</button><strong>${quantity}</strong><button data-cart-plus="${p.id}" ${quantity>=p.stock?'disabled':''} aria-label="Aumentar">+</button></div></div><div><strong>${money(p.sale_price*quantity)}</strong><button class="remove-item" data-cart-remove="${p.id}">QUITAR</button></div></article>`;
      }).join('');
      if (valid.length!==cart.length || valid.some(item=>cart.find(x=>x.id===item.id)?.quantity!==item.quantity)) saveCart(valid);
      updateCartTotals(subtotal);
      $('#go-checkout').disabled = valid.length===0;
      root.onclick = event => {
        const minus=event.target.closest('[data-cart-minus]');
        const plus=event.target.closest('[data-cart-plus]');
        const remove=event.target.closest('[data-cart-remove]');
        let items=getCart();
        if(minus){const item=items.find(x=>x.id===Number(minus.dataset.cartMinus));if(item)item.quantity--;items=items.filter(x=>x.quantity>0);saveCart(items);renderCart(user);}
        if(plus){const item=items.find(x=>x.id===Number(plus.dataset.cartPlus));if(item)item.quantity++;saveCart(items);renderCart(user);}
        if(remove){items=items.filter(x=>x.id!==Number(remove.dataset.cartRemove));saveCart(items);renderCart(user);}
      };
      $('#go-checkout').onclick=()=>location.hash='checkout';
    } catch(err) { root.innerHTML=`<p class="message-box error">${escapeHTML(err.message)}</p>`; }
  }

  function updateCartTotals(subtotal) {
    $('#cart-subtotal').textContent=money(subtotal);
    $('#cart-total').textContent=money(subtotal);
  }

  function bindCartAndCheckout(user) {
    $('#go-checkout')?.addEventListener('click',()=>location.hash='checkout');
    const method=$('#payment-method');
    const cardPanel=$('#card-test-panel');
    method?.addEventListener('change',()=>{cardPanel.hidden=method.value!=='Tarjeta de prueba';});
    $('#card-brand')?.addEventListener('change',updateCardBrandPreview);
    $('#card-number')?.addEventListener('input',formatCardNumber);
    $('#card-expiry')?.addEventListener('input',formatExpiry);
    $('#card-cvv')?.addEventListener('input',e=>e.target.value=e.target.value.replace(/\D/g,'').slice(0,4));
    $('#checkout-form')?.addEventListener('submit',submitCheckout);
  }

  function updateCardBrandPreview() {
    const brand=$('#card-brand')?.value || 'Visa';
    const file=brand==='Visa'?'visa.svg':brand==='Mastercard'?'mastercard.svg':'amex.svg';
    $('#card-network-preview').innerHTML=`<img src="images/${file}" alt="${escapeHTML(brand)}">`;
    const input=$('#card-number');
    if(input){input.value='';input.placeholder=brand==='American Express'?'0000 000000 00000':'0000 0000 0000 0000';}
  }
  function formatCardNumber(event) {
    const input=event.target;
    const brand=$('#card-brand').value;
    const max=brand==='American Express'?15:16;
    const digits=input.value.replace(/\D/g,'').slice(0,max);
    let formatted='';
    if(brand==='American Express') formatted=digits.slice(0,4)+(digits.length>4?' '+digits.slice(4,10):'')+(digits.length>10?' '+digits.slice(10,15):'');
    else formatted=digits.replace(/(\d{4})(?=\d)/g,'$1 ');
    input.value=formatted;
  }
  function formatExpiry(event) {
    const digits=event.target.value.replace(/\D/g,'').slice(0,4);
    event.target.value=digits.length>2?`${digits.slice(0,2)}/${digits.slice(2)}`:digits;
  }
  function validateDemoCard() {
    const brand=$('#card-brand').value;
    const digits=$('#card-number').value.replace(/\D/g,'');
    const required=brand==='American Express'?15:16;
    const expiry=$('#card-expiry').value.trim();
    const cvv=$('#card-cvv').value.trim();
    const expectedCVV=brand==='American Express'?4:3;
    if(digits.length!==required) throw new Error(`Para esta demostración, ${brand} debe tener ${required} dígitos.`);
    if(!/^(0[1-9]|1[0-2])\/\d{2}$/.test(expiry)) throw new Error('El vencimiento debe escribirse como MM/AA.');
    if(cvv.length!==expectedCVV || !/^\d+$/.test(cvv)) throw new Error(`El CVV de prueba debe tener ${expectedCVV} dígitos.`);
    const bank=$('#payment-bank').value;
    if(!bank) throw new Error('Selecciona el banco emisor.');
    return {bank,brand,last4:digits.slice(-4)};
  }

  async function prepareCheckout(user) {
    if(!user || user.role!=='cliente'){location.hash='login';return;}
    const cart=getCart();
    if(!cart.length){location.hash='cart';return;}
    if($('#checkout-name')) $('#checkout-name').value=user.name || '';
    try {
      const products=await API('/api/products');
      const lines=cart.map(item=>({item,p:products.find(p=>p.id===Number(item.id))}));
      if(lines.some(x=>!x.p || x.p.stock<x.item.quantity)) throw new Error('Uno de los productos ya no tiene existencias suficientes. Vuelve al carrito y revisa las cantidades.');
      const subtotal=lines.reduce((sum,x)=>sum+x.p.sale_price*x.item.quantity,0);
      $('#checkout-items').innerHTML=lines.map(x=>`<div class="summary-row"><span>${escapeHTML(x.p.name)} × ${x.item.quantity}</span><strong>${money(x.p.sale_price*x.item.quantity)}</strong></div>`).join('');
      $('#checkout-subtotal').textContent=money(subtotal);$('#checkout-total').textContent=money(subtotal);
      clearMessage($('#checkout-message'));
    } catch(err){setMessage($('#checkout-message'),err.message);}
  }

  async function submitCheckout(event) {
    event.preventDefault();
    const user=window.ZAPATENIS_USER;
    if(!user || user.role!=='cliente'){location.hash='login';return;}
    const form=event.currentTarget;
    const button=$('#confirm-purchase');
    const message=$('#checkout-message');
    const formData=new FormData(form);
    const data={
      customer_name:formData.get('customer_name'),
      customer_document:formData.get('customer_document'),
      customer_phone:formData.get('customer_phone'),
      customer_address:formData.get('customer_address'),
      payment_method:formData.get('payment_method'),
      items:getCart().map(item=>({product_id:Number(item.id),quantity:Number(item.quantity)}))
    };
    if(!data.payment_method){setMessage(message,'Selecciona un medio de pago.');return;}
    if(data.payment_method==='Tarjeta de prueba'){
      try {
        const card=validateDemoCard();
        data.payment_bank=card.bank;data.card_brand=card.brand;data.card_last4=card.last4;
      } catch(err){setMessage(message,err.message);return;}
    }
    // No añadir card-number, vencimiento ni CVV al objeto enviado al servidor.
    button.disabled=true;button.textContent='REGISTRANDO COMPRA…';clearMessage(message);
    try {
      const result=await API('/api/checkout',{method:'POST',body:JSON.stringify(data)});
      localStorage.removeItem('zapatenis-cart');updateCartCount();
      location.href=`factura.html?type=venta&id=${result.sale.id}`;
    } catch(err){setMessage(message,err.message);button.disabled=false;button.textContent='CONFIRMAR COMPRA';}
  }

