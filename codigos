    const email = process.env.ADMIN_EMAIL || 'admin@zapatenis.com';
    const password = process.env.ADMIN_PASSWORD || 'Admin123';
    const hash = await bcrypt.hash(password, 12);

    await run(`INSERT INTO users (name, email, password_hash, role)
        VALUES (?, ?, ?, 'admin')`, ['Administrador ZAPATENIS', email, hash]);
}

