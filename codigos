app.put('/api/admin/products/:id', requireAdmin, asyncRoute(async (req, res) => {
    const id = idNumber(req.params.id);
    if (!id) return res.status(400).json({ error: 'Producto inválido.' });
    const p = readProduct(req.body);
    await transaction(async () => {
        const old = await get('SELECT * FROM products WHERE id = ?', [id]);
        if (!old) throw new Error('Producto no encontrado.');
        await run(`UPDATE products SET name=?,brand=?,audience=?,category=?,description=?,purchase_price=?,sale_price=?,size=?,color=?,stock=?,image_url=?,updated_at=CURRENT_TIMESTAMP WHERE id=?`,
        [p.name,p.brand,p.audience,p.category,p.description,p.purchase_price,p.sale_price,p.size,p.color,p.stock,p.image_url,id]);
        const difference = p.stock - old.stock;
        if (difference !== 0) {
            await run(`INSERT INTO inventory_movements
                (product_id,movement_type,source_type,quantity,previous_stock,new_stock,notes,user_id)
                VALUES (?,'Ajuste','Edición de inventario',?,?,?,?,?)`,
            [id,Math.abs(difference),old.stock,p.stock,'Ajuste manual desde la edición del producto.',req.session.user.id]);
        }
    });
    res.json({ ok: true, message: 'Producto actualizado. Si cambió el stock, quedó registrado el ajuste.' });
}));

app.delete('/api/admin/products/:id', requireAdmin, asyncRoute(async (req, res) => {
    const id = idNumber(req.params.id);
    if (!id) return res.status(400).json({ error: 'Producto inválido.' });
