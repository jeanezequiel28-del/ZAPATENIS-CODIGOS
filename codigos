    const q=$('#movement-search').value.trim().toLowerCase();const list=movementData.filter(m=>[m.product_name,m.brand,m.source_type,m.movement_type,m.notes].join(' ').toLowerCase().includes(q));
    $('#movements-table').innerHTML=list.length?`<table class="data-table"><thead><tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Origen</th><th>Cantidad</th><th>Stock anterior</th><th>Stock nuevo</th><th>Detalle</th></tr></thead><tbody>${list.map(m=>`<tr><td>${dateText(m.created_at)}</td><td>${escapeHTML(m.product_name)}<small>${escapeHTML(m.brand)}</small></td><td>${escapeHTML(m.movement_type)}</td><td>${escapeHTML(m.source_type)}</td><td>${m.quantity}</td><td>${m.previous_stock}</td><td>${m.new_stock}</td><td>${escapeHTML(m.notes)}</td></tr>`).join('')}</tbody></table>`:tableEmpty('No hay movimientos para mostrar.');
  }
  function bindFundAdmin(){$('#refresh-fund')?.addEventListener('click',loadFund);}
  async function loadFund(){
    try{const data=await API('/api/admin/fund');$('#fund-balance').textContent=money(data.balance);$('#fund-table').innerHTML=data.movements.length?`<table class="data-table"><thead><tr><th>Fecha</th><th>Tipo</th><th>Origen</th><th>Descripción</th><th>Importe</th><th>Saldo después</th></tr></thead><tbody>${data.movements.map(m=>`<tr><td>${dateText(m.created_at)}</td><td>${escapeHTML(m.movement_type)}</td><td>${escapeHTML(m.source_type)}</td><td>${escapeHTML(m.description)}</td><td class="${m.amount>=0?'signed-positive':'signed-negative'}">${m.amount>0?'+':''}${money(m.amount)}</td><td>${money(m.balance_after)}</td></tr>`).join('')}</tbody></table>`:tableEmpty('No hay movimientos en el fondo.');}
    catch(err){$('#fund-table').innerHTML=`<div class="message-box error">${escapeHTML(err.message)}</div>`;}
  }

  /* ========================= FACTURA ========================= */
  const code39={
    '0':'nnnwwnwnn','1':'wnnwnnnnw','2':'nnwwnnnnw','3':'wnwwnnnnn','4':'nnnwwnnnw',
    '5':'wnnwwnnnn','6':'nnwwwnnnn','7':'nnnwnnwnw','8':'wnnwnnwnn','9':'nnwwnnwnn'
  };
  function barcodeSVG(value){
    const digits=String(value).replace(/\D/g,'')||'0';const code=`*${digits}*`;let x=8;let bars='';
    for(const char of code){const pattern=code==='**'?'':code39[char];if(!pattern)continue;
      for(let i=0;i<pattern.length;i++){const width=pattern[i]==='w'?3:1.35;if(i%2===0)bars+=`<rect x="${x}" y="1" width="${width}" height="48" fill="#111"/>`;x+=width;}
      x+=1.8;
    }
    return `<svg class="receipt-barcode" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${x+8} 50" role="img" aria-label="Código de barras">${bars}</svg>`;
  }
  const smallNums=['cero','uno','dos','tres','cuatro','cinco','seis','siete','ocho','nueve','diez','once','doce','trece','catorce','quince','dieciséis','diecisiete','dieciocho','diecinueve','veinte','veintiuno','veintidós','veintitrés','veinticuatro','veinticinco','veintiséis','veintisiete','veintiocho','veintinueve'];
  function underHundred(n){if(n<30)return smallNums[n];const tens=['','','','treinta','cuarenta','cincuenta','sesenta','setenta','ochenta','noventa'];const t=Math.floor(n/10);const u=n%10;return tens[t]+(u?' y '+smallNums[u]:'');}
  function underThousand(n){if(n<100)return underHundred(n);if(n===100)return 'cien';const h=Math.floor(n/100),r=n%100;const hundreds=['','ciento','doscientos','trescientos','cuatrocientos','quinientos','seiscientos','setecientos','ochocientos','novecientos'];return hundreds[h]+(r?' '+underHundred(r):'');}
  function integerWords(n){
    if(n===0)return 'cero';if(n<0)return 'menos '+integerWords(-n);
    const parts=[];const scales=['','mil','millón','mil millones','billón'];let group=0;
    while(n>0){const chunk=n%1000;if(chunk){let phrase=underThousand(chunk);if(group===1)phrase=chunk===1?'mil':`${phrase} mil`;else if(group===2)phrase=chunk===1?'un millón':`${phrase} millones`;else if(group===3)phrase=chunk===1?'mil millones':`${phrase} mil millones`;else if(group===4)phrase=chunk===1?'un billón':`${phrase} billones`;parts.unshift(phrase);}n=Math.floor(n/1000);group++;}
    return parts.join(' ').replace(/uno mil/g,'mil').replace(/uno millones/g,'un millón');
  }
  function amountWords(value){const n=Math.max(0,Number(value)||0);const whole=Math.floor(n+1e-8);const cents=Math.round((n-whole)*100);let words=integerWords(whole);words=words.replace(/veintiuno$/,'veintiún').replace(/ y uno$/,' y un').replace(/uno$/,'un');return `${words} ${whole===1?'peso':'pesos'} con ${String(cents).padStart(2,'0')}/100`.toUpperCase();}
  async function startInvoice(){
    const root=$('#invoice-root');const params=new URLSearchParams(location.search);const type=params.get('type')||'venta';const id=Number(params.get('id'));
    if(!id||!['venta','compra'].includes(type)){root.innerHTML='<p class="receipt-loading">No se indicó una factura válida.</p>';return;}
    try{
      const data=await API(`/api/invoices/${type}/${id}`);
      const isSale=type==='venta';const invoiceNo=data.invoice_number||`ZAP-${id}`;const date=isSale?data.sale_date:data.purchase_date;
      const customer=isSale?data.customer_name:data.supplier_name;
      const doc=isSale?data.customer_document:data.supplier_document;
      const phone=isSale?data.customer_phone:data.supplier_phone;
      const address=isSale?data.customer_address:'';
      const paid=Number(data.amount_paid??data.total);const balance=Number(data.balance_due??Math.max(0,data.total-paid));
      const items=data.items||[];
      const rows=items.map(item=>`<div class="receipt-desc"><strong>${escapeHTML(item.product_name)}</strong><br>Cant.: ${item.quantity} × ${money(isSale?item.unit_price:item.unit_cost)} = ${money(item.line_total??item.total)}</div>`).join('');
      root.innerHTML=`
        <div class="receipt-top"><img class="receipt-logo" src="images/logo.png" alt="Logo ZAPATENIS"><div class="receipt-brand"><h1>ZAPATENIS</h1><p>TIENDA DE CALZADO DEPORTIVO</p><p>${isSale?'FACTURA DE VENTA':'FACTURA DE COMPRA'}</p></div></div>
        <div class="receipt-company">Santiago de los Caballeros, República Dominicana<br>RNC: PENDIENTE DE CONFIGURAR<br>Teléfono: PENDIENTE DE CONFIGURAR</div>
        <hr class="receipt-rule">
        <div class="receipt-date">FECHA: ${dateText(date)}<br>FACTURA: ${escapeHTML(invoiceNo)}</div>
        <hr class="receipt-rule">
        <div class="receipt-section-title">DESCRIPCIÓN</div>
        <hr class="receipt-rule">
        ${rows}
        <hr class="receipt-rule">
        <div class="receipt-summary">
          <div class="receipt-summary-row"><span>SUBTOTAL:</span><strong>${money(data.subtotal)}</strong></div>
          <div class="receipt-summary-row"><span>DESCUENTO:</span><strong>${money(data.discount||0)}</strong></div>
          <div class="receipt-summary-row receipt-total"><span>TOTAL:</span><strong>${money(data.total)}</strong></div>
          <div class="receipt-summary-row"><span>SALDO:</span><strong>${money(balance)}</strong></div>
        </div>
        <hr class="receipt-rule">
        <div class="receipt-son">SON: ${amountWords(data.total)}</div>
        <hr class="receipt-rule">
        <div class="receipt-method">MEDIO DE PAGO: ${escapeHTML(isSale?data.payment_method:'Pago a proveedor desde fondo')} ${isSale&&data.payment_method==='Tarjeta de prueba'?`· ${escapeHTML(data.payment_bank)} · ${escapeHTML(data.card_brand)} **** ${escapeHTML(data.card_last4)}`:''}</div>${isSale&&data.payment_method==='Tarjeta de prueba'?`<div class="receipt-payment-logos"><img src="images/${data.payment_bank==='Banco Popular'?'banco-popular.svg':data.payment_bank==='Banco BHD'?'banco-bhd.svg':'banreservas.svg'}" alt="Banco"><img src="images/${data.card_brand==='Visa'?'visa.svg':data.card_brand==='Mastercard'?'mastercard.svg':'amex.svg'}" alt="Red de tarjeta"></div>`:''}
        <hr class="receipt-rule">
        <div class="receipt-section-title">${isSale?'CLIENTE':'PROVEEDOR'}</div>
        <hr class="receipt-rule">
        <div class="receipt-customer">
          <div><strong>CÓDIGO:</strong> ${escapeHTML(invoiceNo)}</div>
          <div><strong>NOMBRE:</strong> ${escapeHTML(customer||'—')}</div>
          <div><strong>CÉDULA / RNC:</strong> ${escapeHTML(doc||'—')}</div>
          ${isSale?`<div><strong>DIRECCIÓN:</strong> ${escapeHTML(address||'—')}</div>`:''}
          <div><strong>TELÉFONO:</strong> ${escapeHTML(phone||'—')}</div>
          <div><strong>ESTADO:</strong> ${balance>0?'PENDIENTE':'PAGADO'}</div>
        </div>
        <hr class="receipt-rule">
        ${barcodeSVG(id)}
        <div class="receipt-barcode-number">${escapeHTML(invoiceNo)}</div>
        <div class="receipt-footer">Operador: ${escapeHTML(data.operator_name||'Administrador')}<br>Impresión: ${new Date().toLocaleString('es-DO')}</div>
        <div class="receipt-thanks">GRACIAS POR PREFERIR ZAPATENIS</div>`;
    }catch(err){root.innerHTML=`<p class="receipt-loading">${escapeHTML(err.message)}</p>`;}
    $('#print-invoice')?.addEventListener('click',()=>window.print());
  }

  document.addEventListener('DOMContentLoaded',()=>{
    const page=document.body.dataset.page;
    if(page==='store')startStore();
    else if(page==='admin')startAdmin();
    else if(page==='invoice')startInvoice();
  });
})();

