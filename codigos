async function createSale(body, user) {
    const customerName = text(body.customer_name,120) || user.name;
    const document = text(body.customer_document,40);
    const phone = text(body.customer_phone,40);
    const address = text(body.customer_address,250);
    const saleDate = validDate(body.sale_date || localDate());
    const paymentMethod = text(body.payment_method,40);
    const discount = nonNegative(body.discount || 0,'Descuento');
    const items = Array.isArray(body.items) ? body.items : [];
    if (!customerName) throw new Error('El nombre del cliente es obligatorio.');
    if (!['Efectivo','Transferencia','Tarjeta de prueba'].includes(paymentMethod)) throw new Error('Selecciona un medio de pago válido.');
    if (!items.length) throw new Error('El carrito está vacío.');

    let bank = '', cardBrand = '', cardLast4 = '';
    if (paymentMethod === 'Tarjeta de prueba') {
        bank = text(body.payment_bank,40);
        cardBrand = text(body.card_brand,30);
        cardLast4 = text(body.card_last4,4);
        if (!BANKS.includes(bank) || !CARD_BRANDS.includes(cardBrand) || !/^\d{4}$/.test(cardLast4)) {
            throw new Error('Completa el banco, la marca y los últimos cuatro dígitos de la tarjeta de prueba.');
        }
    }

    return transaction(async () => {
        const quantities = new Map();
        for (const item of items) {
            const productId = idNumber(item.product_id);
            const quantity = positiveInt(item.quantity,'Cantidad');
            if (!productId) throw new Error('Hay un producto inválido en el carrito.');
            quantities.set(productId,(quantities.get(productId)||0)+quantity);
        }
        const parsed = [];
        let subtotal = 0;
        for (const [productId,quantity] of quantities) {
            const product = await get('SELECT * FROM products WHERE id=? AND active=1',[productId]);
            if (!product) throw new Error('Uno de los productos ya no está disponible.');
            if (Number(product.stock) < quantity) throw new Error(`Stock insuficiente para ${product.name}. Quedan ${product.stock}.`);
            const unitPrice = Number(product.sale_price);
            const lineTotal = roundMoney(unitPrice * quantity);
            subtotal += lineTotal;
            parsed.push({product,quantity,unitPrice,lineTotal});
        }
        subtotal = roundMoney(subtotal);
        if (discount > subtotal) throw new Error('El descuento no puede superar el subtotal.');
        const total = roundMoney(subtotal - discount);
        const paid = total;
        const balanceDue = roundMoney(total - paid);

        const sale = await run(`INSERT INTO sales
            (user_id,customer_name,customer_document,customer_phone,customer_address,sale_date,payment_method,payment_bank,card_brand,card_last4,subtotal,discount,total,amount_paid,balance_due,operator_name)
            VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`,
            [user.id,customerName,document,phone,address,saleDate,paymentMethod,bank,cardBrand,cardLast4,subtotal,discount,total,paid,balanceDue,user.name]);
        const invoiceNumber = `ZAP-${String(sale.id).padStart(7,'0')}`;
        await run('UPDATE sales SET invoice_number=? WHERE id=?',[invoiceNumber,sale.id]);

        for (const item of parsed) {
            const before = Number(item.product.stock);
            const after = before - item.quantity;
            await run(`INSERT INTO sale_items (sale_id,product_id,product_name,brand,size,quantity,unit_price,line_total)
                VALUES (?,?,?,?,?,?,?,?)`,
                [sale.id,item.product.id,item.product.name,item.product.brand,item.product.size,item.quantity,item.unitPrice,item.lineTotal]);
            await run('UPDATE products SET stock=?,updated_at=CURRENT_TIMESTAMP WHERE id=?',[after,item.product.id]);
            await run(`INSERT INTO inventory_movements
                (product_id,movement_type,source_type,source_id,quantity,previous_stock,new_stock,notes,user_id)
                VALUES (?,'Salida','Venta',?,?,?,?,?,?)`,
                [item.product.id,sale.id,item.quantity,before,after,`Salida por factura ${invoiceNumber}`,user.id]);
        }

        const fund = await fundRow();
        const afterBalance = roundMoney(Number(fund.balance) + paid);
        await run('UPDATE business_fund SET balance=? WHERE id=1',[afterBalance]);
        await run(`INSERT INTO fund_movements
            (movement_type,source_type,source_id,amount,balance_after,description,user_id)
            VALUES ('Ingreso','Venta',?,?,?,?,?)`,
            [sale.id,paid,afterBalance,`Ingreso por venta ${invoiceNumber}`,user.id]);

        return { id:sale.id, invoice_number:invoiceNumber, subtotal, discount, total, amount_paid:paid, balance_due:balanceDue };
    });
}

