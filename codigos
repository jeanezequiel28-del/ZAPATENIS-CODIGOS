/* ---------------- PRODUCTOS ADMIN ---------------- */
function readProduct(body) {
    const product = {
        name: text(body.name, 120),
        brand: text(body.brand, 80),
        audience: text(body.audience, 30),
        category: text(body.category, 40),
        description: text(body.description, 1000),
        purchase_price: nonNegative(body.purchase_price, 'Precio de compra'),
        sale_price: nonNegative(body.sale_price, 'Precio de venta'),
        size: text(body.size, 30),
        color: text(body.color, 50),
        stock: Number(body.stock),
        image_url: text(body.image_url, 300)
    };
    if (!product.name || !product.brand) throw new Error('Nombre y marca son obligatorios.');
    if (!AUDIENCES.includes(product.audience)) throw new Error('Selecciona un público válido.');
    if (!CATEGORIES.includes(product.category)) throw new Error('Selecciona una categoría válida.');
    if (!Number.isSafeInteger(product.stock) || product.stock < 0) throw new Error('El stock debe ser un entero igual o mayor que cero.');
    return product;
}

app.get('/api/admin/products', requireAdmin, asyncRoute(async (req, res) => {
