```javascript
const sqlite3 = require('sqlite3').verbose();
const path = require('path');
const bcrypt = require('bcryptjs');

// Si tu archivo de base de datos tiene otro nombre, cambia SOLO esta línea.
// Esta versión crea zapatenis.db y deja intacto cualquier .db antiguo.
const DATABASE_FILE = process.env.DB_FILE || 'zapatenis.db';
const db = new sqlite3.Database(path.join(__dirname, DATABASE_FILE));

db.configure('busyTimeout', 10000);

function run(sql, params = []) {
    return new Promise((resolve, reject) => {
        db.run(sql, params, function (err) {
            if (err) return reject(err);
            resolve({ id: this.lastID, changes: this.changes });
        });
    });
}

function get(sql, params = []) {
    return new Promise((resolve, reject) => {
        db.get(sql, params, (err, row) => err ? reject(err) : resolve(row));
    });
}

function all(sql, params = []) {
    return new Promise((resolve, reject) => {
        db.all(sql, params, (err, rows) => err ? reject(err) : resolve(rows));
    });
}

let txQueue = Promise.resolve();
function transaction(work) {
    const job = txQueue.then(async () => {
        await run('BEGIN IMMEDIATE');
        try {
            const value = await work();
            await run('COMMIT');
            return value;
        } catch (err) {
            await run('ROLLBACK').catch(() => {});
            throw err;
        }
    });
    txQueue = job.catch(() => {});
    return job;
}

