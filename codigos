  function productOptions(products, kind){
    const available=kind==='sale'?products.filter(p=>p.stock>0):products;
    return '<option value="">Selecciona un producto</option>'+available.map(p=>`<option value="${p.id}">${escapeHTML(p.name)} · ${escapeHTML(p.brand)} · Stock ${p.stock}</option>`).join('');
  }
  function makeOperationLine(kind, products){
    const line=document.createElement('div');line.className='operation-line';
    const isPurchase=kind==='purchase';
    line.innerHTML=`<div class="operation-line-grid">
      <label class="field">Producto<select data-line-product required>${productOptions(products,kind)}</select></label>
      <label class="field">Cantidad<input data-line-quantity type="number" min="1" step="1" value="1" required></label>
      <label class="field">${isPurchase?'Costo unitario':'Precio unitario'}<input data-line-price type="number" min="0" step="0.01" value="0" ${isPurchase?'':'readonly'} required></label>
      <label class="field">Total línea<input data-line-total type="text" readonly value="RD$ 0.00"></label>
      <button type="button" class="remove-line" data-remove-line>Quitar</button>
    </div>`;
    const select=$('[data-line-product]',line);select.addEventListener('change',()=>{
      const p=products.find(x=>x.id===Number(select.value));const price=$('[data-line-price]',line);
      if(p)price.value=isPurchase?Number(p.purchase_price):Number(p.sale_price);
      calcOperation(kind);
    });
    line.addEventListener('input',()=>calcOperation(kind));
    $('[data-remove-line]',line).addEventListener('click',()=>{line.remove();calcOperation(kind);});
    return line;
  }
  function calcOperation(kind){
    const selector=kind==='purchase'?'#purchase-lines':'#sale-lines';
    const lines=$$(`${selector} .operation-line`);let subtotal=0;
    lines.forEach(line=>{const q=Number($('[data-line-quantity]',line).value)||0;const p=Number($('[data-line-price]',line).value)||0;const total=q*p;subtotal+=total;$('[data-line-total]',line).value=money(total);});
    const discount=Number($(kind==='purchase'?'#purchase-discount':'#sale-discount').value)||0;
    const total=Math.max(0,subtotal-discount);
    $(kind==='purchase'?'#purchase-total':'#sale-total').textContent=`Subtotal ${money(subtotal)} · Descuento ${money(discount)} · TOTAL ${money(total)}`;
  }
  function getOperationItems(kind){
    const selector=kind==='purchase'?'#purchase-lines':'#sale-lines';
    return $$('.operation-line',$(selector)).map(line=>({
      product_id:Number($('[data-line-product]',line).value),
      quantity:Number($('[data-line-quantity]',line).value),
      unit_cost:Number($('[data-line-price]',line).value)
    }));
  }

