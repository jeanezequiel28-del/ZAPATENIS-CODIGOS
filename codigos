app.post('/api/admin/products', requireAdmin, asyncRoute(async (req, res) => {
    const p = readProduct(req.body);
    const result = await transaction(async () => {
        const r = await run(`INSERT INTO products
            (name,brand,audience,category,description,purchase_price,sale_price,size,color,stock,image_url)
            VALUES (?,?,?,?,?,?,?,?,?,?,?)`,
        [p.name,p.brand,p.audience,p.category,p.description,p.purchase_price,p.sale_price,p.size,p.color,p.stock,p.image_url]);
        if (p.stock > 0) {
            await run(`INSERT INTO inventory_movements
                (product_id,movement_type,source_type,quantity,previous_stock,new_stock,notes,user_id)
                VALUES (?,'Ajuste','Stock inicial',?,0,?,?,?)`,
            [r.id,p.stock,p.stock,'Existencia inicial al crear el producto.',req.session.user.id]);
        }
        return r;
    });
    res.status(201).json({ ok: true, id: result.id, message: 'Producto creado correctamente.' });
