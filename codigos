## `server.js`

```javascript
const express = require('express');
const session = require('express-session');
const bcrypt = require('bcryptjs');
const path = require('path');
const {
    run, get, all, transaction, initDB
} = require('./database');

const app = express();
const PORT = Number(process.env.PORT) || 3000;
const PUBLIC_DIR = path.join(__dirname, 'public');
const AUDIENCES = ['Hombre', 'Mujer', 'Niño', 'Niña'];
const CATEGORIES = ['Baloncesto', 'Fútbol', 'Atletismo', 'Béisbol', 'Casual'];
const BANKS = ['Banco Popular', 'Banco BHD', 'Banreservas'];
const CARD_BRANDS = ['Visa', 'Mastercard', 'American Express'];

app.disable('x-powered-by');
app.use(express.json({ limit: '1mb' }));
app.use(express.urlencoded({ extended: true }));
app.use(session({
    name: 'zapatenis.sid',
    secret: process.env.SESSION_SECRET || 'clave-local-zapatenis-cambiar-en-produccion',
    resave: false,
    saveUninitialized: false,
    cookie: {
        httpOnly: true,
        sameSite: 'lax',
        secure: false,
        maxAge: 8 * 60 * 60 * 1000
    }
}));
app.use(express.static(PUBLIC_DIR));

function asyncRoute(fn) {
    return (req, res, next) => Promise.resolve(fn(req, res, next)).catch(next);
}
function text(value, max = 250) {
    return String(value ?? '').trim().slice(0, max);
}
function idNumber(value) {
    const n = Number(value);
    return Number.isSafeInteger(n) && n > 0 ? n : null;
}
function nonNegative(value, label) {
    const n = Number(value);
    if (!Number.isFinite(n) || n < 0) throw new Error(`${label} debe ser un número igual o mayor que cero.`);
    return Math.round((n + Number.EPSILON) * 100) / 100;
}
function positiveInt(value, label) {
    const n = Number(value);
    if (!Number.isSafeInteger(n) || n <= 0) throw new Error(`${label} debe ser un número entero mayor que cero.`);
    return n;
}
function roundMoney(value) {
    return Math.round((Number(value) + Number.EPSILON) * 100) / 100;
}
function localDate() {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}
function validDate(value) {
    const s = text(value, 10);
    if (!/^\d{4}-\d{2}-\d{2}$/.test(s) || Number.isNaN(Date.parse(`${s}T12:00:00`))) {
        throw new Error('La fecha no es válida.');
    }
    return s;
}
function safeUser(user) {
    return user ? { id: user.id, name: user.name, email: user.email, role: user.role } : null;
}
function requireAuth(req, res, next) {
    if (!req.session.user) return res.status(401).json({ error: 'Inicia sesión para continuar.' });
    next();
}
function requireAdmin(req, res, next) {
    if (!req.session.user) return res.status(401).json({ error: 'Inicia sesión para continuar.' });
    if (req.session.user.role !== 'admin') return res.status(403).json({ error: 'Esta sección es exclusiva del administrador.' });
    next();
}
function requireCustomer(req, res, next) {
    if (!req.session.user) return res.status(401).json({ error: 'Inicia sesión para comprar.' });
    if (req.session.user.role !== 'cliente') return res.status(403).json({ error: 'Esta operación es para cuentas de cliente.' });
    next();
}
function regenerateSession(req) {
    return new Promise((resolve, reject) => req.session.regenerate(err => err ? reject(err) : resolve()));
}
function saveSession(req) {
    return new Promise((resolve, reject) => req.session.save(err => err ? reject(err) : resolve()));
}

/* ---------------- AUTH ---------------- */
app.get('/api/me', (req, res) => res.json({ user: safeUser(req.session.user) }));

app.post('/api/register', asyncRoute(async (req, res) => {
    const name = text(req.body.name, 100);
    const email = text(req.body.email, 150).toLowerCase();
    const password = String(req.body.password || '');
    if (!name || !email || !password) return res.status(400).json({ error: 'Completa todos los campos.' });
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return res.status(400).json({ error: 'Escribe un correo válido.' });
    if (password.length < 8) return res.status(400).json({ error: 'La contraseña debe tener al menos 8 caracteres.' });
    if (await get('SELECT id FROM users WHERE email = ?', [email])) return res.status(409).json({ error: 'Ese correo ya está registrado.' });

    const hash = await bcrypt.hash(password, 12);
    const result = await run('INSERT INTO users (name,email,password_hash,role) VALUES (?,?,?,?)', [name, email, hash, 'cliente']);
    const user = { id: result.id, name, email, role: 'cliente' };
    await regenerateSession(req);
    req.session.user = user;
    await saveSession(req);
    res.status(201).json({ ok: true, user: safeUser(user) });
}));

app.post('/api/login', asyncRoute(async (req, res) => {
    const email = text(req.body.email, 150).toLowerCase();
    const password = String(req.body.password || '');
    const user = await get('SELECT * FROM users WHERE email = ?', [email]);
    if (!user || !(await bcrypt.compare(password, user.password_hash))) {
        return res.status(401).json({ error: 'Correo o contraseña incorrectos.' });
    }
    const sessionUser = { id: user.id, name: user.name, email: user.email, role: user.role };
    await regenerateSession(req);
    req.session.user = sessionUser;
    await saveSession(req);
    res.json({ ok: true, user: safeUser(sessionUser) });
}));

app.post('/api/logout', requireAuth, (req, res) => {
    req.session.destroy(err => {
        if (err) return res.status(500).json({ error: 'No se pudo cerrar la sesión.' });
        res.clearCookie('zapatenis.sid');
        res.json({ ok: true });
    });
});

