async function seedSuppliers() {
    const count = await get('SELECT COUNT(*) AS n FROM suppliers');
    if (count.n > 0) return;

    const names = [
        'Proveedor Deportivo Norte',
        'Distribuidora de Calzado Demo',
        'Importadora Deportiva Demo',
        'Suministros Zapatenis Demo',
        'Calzado y Deportes Demo'
    ];

    for (const name of names) {
        await run('INSERT INTO suppliers (name) VALUES (?)', [name]);
    }
}

async function seedProducts() {
    const count = await get('SELECT COUNT(*) AS n FROM products');
    if (count.n > 0) return;

    const audiences = ['Hombre', 'Mujer', 'Niño', 'Niña'];
    const categories = {
        Baloncesto: ['Court Rise','Jump Pro','Dunk Motion','Sky Bounce','Hoop Elite'],
        Fútbol: ['Speed Turf','Control Match','Future Sprint','Goal Strike','Predator Edge'],
        Atletismo: ['Run Flex','Velocity','Air Motion','Track Light','Sprint Max'],
        Béisbol: ['Diamond Pro','Base Runner','Field Grip','Power Cleat','Dugout Flex'],
        Casual: ['Street Classic','Urban One','Daily Comfort','Retro Walk','Essential Low']
    };
    const brands = ['Nike','Adidas','Puma','New Balance','Reebok'];
    const colors = ['Negro','Blanco','Azul','Gris','Rojo'];

    await transaction(async () => {
        for (const audience of audiences) {
            for (const [category, models] of Object.entries(categories)) {
                for (let i = 0; i < 5; i++) {
                    const salePrice = 3200 + (i * 400) + (audiences.indexOf(audience) * 150);
                    const purchasePrice = Math.round(salePrice * 0.60);
                    const size = audience === 'Hombre' ? String(40 + i)
                        : audience === 'Mujer' ? String(36 + i)
                        : String(28 + i);
                    await run(`INSERT INTO products
                        (name,brand,audience,category,description,purchase_price,sale_price,size,color,stock,image_url)
                        VALUES (?,?,?,?,?,?,?,?,?,?,?)`, [
                        `${brands[i]} ${models[i]} ${audience}`,
                        brands[i], audience, category,
                        `Modelo de demostración de ${category.toLowerCase()} para ${audience.toLowerCase()}. Puedes editar estos datos.`,
                        purchasePrice, salePrice, size, colors[i], [8,6,4,10,3][i], ''
                    ]);
                }
            }
        }
    });
}

async function initDB() {
    await createSchema();
    await seedAdmin();
    await seedFund();
    await seedSuppliers();
    await seedProducts();
    console.log(`SQLite listo: ${DATABASE_FILE}`);
}

module.exports = { db, run, get, all, transaction, initDB, DATABASE_FILE };

