app.post('/api/admin/purchases', requireAdmin, asyncRoute(async (req,res) => {
    const supplierId = idNumber(req.body.supplier_id);
    const purchaseDate = validDate(req.body.purchase_date || localDate());
    const supplierInvoice = text(req.body.supplier_invoice,80);
    const notes = text(req.body.notes,500);
    const discount = nonNegative(req.body.discount || 0,'Descuento');
    const items = Array.isArray(req.body.items) ? req.body.items : [];
    if (!supplierId) return res.status(400).json({ error:'Selecciona un proveedor.' });
    if (!items.length) return res.status(400).json({ error:'Agrega al menos un producto.' });

    const outcome = await transaction(async () => {
        const supplier = await get('SELECT * FROM suppliers WHERE id=? AND active=1',[supplierId]);
        if (!supplier) throw new Error('El proveedor seleccionado no está disponible.');
        const parsed = [];
        let subtotal = 0;
        for (const item of items) {
            const productId = idNumber(item.product_id);
            const quantity = positiveInt(item.quantity,'Cantidad');
            const cost = nonNegative(item.unit_cost,'Costo unitario');
            if (!productId) throw new Error('Hay un producto inválido en la compra.');
            const product = await get('SELECT * FROM products WHERE id=? AND active=1',[productId]);
            if (!product) throw new Error('Uno de los productos ya no está disponible.');
            const lineTotal = roundMoney(quantity * cost);
            subtotal += lineTotal;
            parsed.push({product,quantity,cost,lineTotal});
        }
        subtotal = roundMoney(subtotal);
        if (discount > subtotal) throw new Error('El descuento no puede superar el subtotal.');
        const total = roundMoney(subtotal - discount);
        const fund = await fundRow();
        if (Number(fund.balance) < total) throw new Error('El fondo no tiene saldo suficiente para esta compra.');

        const purchase = await run(`INSERT INTO purchases
            (supplier_id,supplier_name,supplier_document,supplier_phone,purchase_date,subtotal,discount,total,notes,user_id)
            VALUES (?,?,?,?,?,?,?,?,?,?)`,
            [supplier.id,supplier.name,supplier.document,supplier.phone,purchaseDate,subtotal,discount,total,notes,req.session.user.id]);
        const invoiceNumber = `COMP-${String(purchase.id).padStart(6,'0')}`;
        await run('UPDATE purchases SET invoice_number=? WHERE id=?',[invoiceNumber,purchase.id]);

        for (const item of parsed) {
            const before = Number(item.product.stock);
            const after = before + item.quantity;
            const oldVal = before * Number(item.product.purchase_price);
            const average = after > 0 ? roundMoney((oldVal + item.quantity * item.cost) / after) : item.cost;
            await run(`INSERT INTO purchase_items (purchase_id,product_id,product_name,quantity,unit_cost,line_total)
                VALUES (?,?,?,?,?,?)`,[purchase.id,item.product.id,item.product.name,item.quantity,item.cost,item.lineTotal]);
            await run('UPDATE products SET stock=?,purchase_price=?,updated_at=CURRENT_TIMESTAMP WHERE id=?',[after,average,item.product.id]);
            await run(`INSERT INTO inventory_movements
                (product_id,movement_type,source_type,source_id,quantity,previous_stock,new_stock,notes,user_id)
                VALUES (?,'Entrada','Compra',?,?,?,?,?,?)`,
                [item.product.id,purchase.id,item.quantity,before,after,`Entrada por factura ${invoiceNumber}`,req.session.user.id]);
        }
        const beforeBalance = Number(fund.balance);
        const afterBalance = roundMoney(beforeBalance - total);
        await run('UPDATE business_fund SET balance=? WHERE id=1',[afterBalance]);
        await run(`INSERT INTO fund_movements
            (movement_type,source_type,source_id,amount,balance_after,description,user_id)
            VALUES ('Gasto','Compra',?,?,?,?,?)`,
            [purchase.id,-total,afterBalance,`Compra ${invoiceNumber} a ${supplier.name}`,req.session.user.id]);
        return { id:purchase.id, invoice_number:invoiceNumber, total, balance:afterBalance };
    });
    res.status(201).json({ ok:true, purchase:outcome });
}));

